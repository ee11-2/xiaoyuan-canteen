<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="食堂小馆">
<meta name="theme-color" content="#FF7FA8">
<link rel="manifest" href="manifest.webmanifest">
<link rel="apple-touch-icon" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 180 180'><defs><pattern id='p' width='22' height='22' patternUnits='userSpaceOnUse'><circle cx='11' cy='11' r='3' fill='%23FFC9DB'/></pattern></defs><rect width='180' height='180' rx='40' fill='%23FFF3F7'/><rect width='180' height='180' rx='40' fill='url(%23p)'/><circle cx='90' cy='90' r='50' fill='white' stroke='%23FFD9E5' stroke-width='3'/><path d='M62 72 C57 80 68 82 63 88 M90 68 C85 76 96 78 91 84 M118 72 C113 80 124 82 119 88' stroke='%23FFB3CC' stroke-width='4.5' fill='none' stroke-linecap='round'/><path d='M46 100 A36 36 0 0 0 134 100 Z' fill='%23FF7FA8'/><circle cx='70' cy='114' r='3.5' fill='white'/><circle cx='110' cy='114' r='3.5' fill='white'/></svg>">
<title>呆呆大王的食堂小馆 · Dot Dot Café</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{
  --pink-50:#FFF3F7;
  --pink-100:#FFEDF3;
  --pink-200:#FFD9E5;
  --pink-300:#FFC2D5;
  --pink-400:#FF9FBE;
  --pink-500:#FF7FA8;
  --pink-600:#F0568D;
  --pink-700:#E8447C;
  --ink-900:#3A1A2A;
  --ink-700:#5C354A;
  --ink-500:#8A5C74;
  --ink-300:#B27A93;
  --ink-150:#CFA6B9;
  --white:#FFFFFF;
  --radius-s:10px;
  --radius-m:16px;
  --radius-l:22px;
  --radius-xl:28px;
  --radius-full:999px;
  --space-1:4px;--space-2:8px;--space-3:12px;--space-4:16px;
  --space-5:20px;--space-6:24px;--space-7:28px;--space-8:32px;
  --shadow-sm:0 2px 8px rgba(232,68,124,.08);
  --shadow-md:0 6px 20px rgba(232,68,124,.10);
  --shadow-lg:0 12px 36px rgba(232,68,124,.14);
  --shadow-xl:0 22px 60px rgba(232,68,124,.20);
}
html,body{height:100%;overflow:hidden}
body{
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  color:var(--ink-900);background:var(--pink-50);-webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;overscroll-behavior:none;user-select:none;
}
.pattern-dots{
  background-color:var(--pink-100);
  background-image:radial-gradient(var(--pink-200) 2.5px,transparent 2.6px);
  background-size:28px 28px;background-position:0 0;
}
.pattern-dots-lg{
  background-color:var(--pink-500);
  background-image:radial-gradient(rgba(255,255,255,.32) 4px,transparent 4.2px);
  background-size:40px 40px;
}

/* ================== WELCOME ================== */
#welcome{
  position:fixed;inset:0;z-index:100;display:flex;flex-direction:column;align-items:center;
  transition:opacity .55s cubic-bezier(.2,.8,.2,1),transform .55s cubic-bezier(.2,.8,.2,1);
}
#welcome.fade{opacity:0;transform:scale(1.03);pointer-events:none}
.wc{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0 34px;text-align:center;width:100%}
.mascot-wrap{position:relative;margin-bottom:34px}
.mascot-ring{
  position:absolute;inset:-16px;border-radius:50%;
  border:2.5px dashed var(--pink-400);
  animation:ringSpin 18s linear infinite;
}
@keyframes ringSpin{to{transform:rotate(360deg)}}
.mascot{
  width:148px;height:148px;border-radius:50%;background:var(--white);
  box-shadow:0 18px 46px rgba(232,68,124,.18),inset 0 0 0 3px var(--pink-200);
  display:flex;align-items:center;justify-content:center;position:relative;
  animation:bob 4s ease-in-out infinite;
}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
.kicker{
  font-size:11.5px;font-weight:800;letter-spacing:.34em;text-transform:uppercase;
  color:var(--pink-700);margin-bottom:14px;
}
.hello{
  font-size:44px;font-weight:900;letter-spacing:.01em;line-height:1.1;
  color:var(--ink-900);
}
.hello em{font-style:normal;color:var(--pink-600)}
.sub{
  margin-top:14px;font-size:15px;line-height:1.7;color:var(--ink-500);
  max-width:280px;
}
.start{
  margin-top:auto;margin-bottom:calc(env(safe-area-inset-bottom) + 34px);
  width:calc(100% - 68px);height:58px;border-radius:var(--radius-full);
  background:linear-gradient(150deg,var(--pink-400),var(--pink-600));color:var(--white);
  font-size:16px;font-weight:800;letter-spacing:.04em;border:none;cursor:pointer;
  box-shadow:0 14px 32px rgba(240,86,141,.38),inset 0 1px 0 rgba(255,255,255,.5);
  display:flex;align-items:center;justify-content:center;gap:10px;
  transition:transform .15s ease;
}
.start:active{transform:scale(.97)}
.skip{margin-top:14px;font-size:12.5px;color:var(--ink-300);font-weight:600;margin-bottom:0}

/* ================== SHELL ================== */
#app{
  position:fixed;inset:0;display:none;flex-direction:column;
  padding-top:env(safe-area-inset-top);
  padding-bottom:calc(env(safe-area-inset-bottom) + 96px);
}

/* ---- Top Header ---- */
.head{
  padding:16px 20px 14px;flex-shrink:0;
}
.greet{display:flex;align-items:center;justify-content:space-between;gap:12px}
.g-lbl{font-size:11px;font-weight:800;letter-spacing:.22em;color:var(--pink-700)}
.g-title{font-size:23px;font-weight:800;letter-spacing:-.01em;color:var(--ink-900);margin-top:4px}
.ava{
  width:44px;height:44px;border-radius:50%;background:var(--white);
  box-shadow:var(--shadow-md),inset 0 0 0 2px var(--pink-200);
  display:flex;align-items:center;justify-content:center;
  font-size:17px;font-weight:900;color:var(--pink-600);flex-shrink:0;
}
.search{
  margin-top:14px;height:44px;border-radius:22px;background:var(--white);
  box-shadow:var(--shadow-sm);display:flex;align-items:center;gap:10px;
  padding:0 16px;color:var(--ink-300);font-size:13.5px;font-weight:500;
}

/* ---- Content Card ---- */
.body{
  flex:1;background:var(--white);
  border-radius:30px 30px 0 0 / 30px 30px 0 0;
  box-shadow:0 -10px 30px rgba(232,68,124,.05);
  padding:18px 0 0;overflow:hidden;display:flex;flex-direction:column;
  position:relative;
}
.body::before{
  content:"";position:absolute;top:10px;left:50%;transform:translateX(-50%);
  width:40px;height:4px;border-radius:4px;background:var(--pink-200);opacity:.6;
}

/* Floor Segmented Control */
.seg-wrap{padding:4px 20px 0;flex-shrink:0}
.seg{
  display:grid;grid-template-columns:1fr 1fr;background:var(--pink-100);
  border-radius:18px;padding:5px;gap:5px;
}
.seg button{
  border:none;padding:10px 0;border-radius:14px;background:transparent;
  font-size:13.5px;font-weight:700;color:var(--ink-300);cursor:pointer;
  display:flex;flex-direction:column;align-items:center;gap:2px;
  transition:all .2s ease;
}
.seg button small{font-size:10px;font-weight:600;opacity:.75}
.seg button.on{
  background:var(--white);color:var(--pink-600);
  box-shadow:var(--shadow-sm);
}

/* Chips */
.chips{
  display:flex;gap:8px;padding:14px 20px 10px;overflow-x:auto;scrollbar-width:none;
  flex-shrink:0;
}
.chips::-webkit-scrollbar{display:none}
.chip{
  padding:7.5px 14px;border-radius:var(--radius-full);flex-shrink:0;cursor:pointer;
  background:var(--white);border:1.5px solid var(--pink-200);
  font-size:12.5px;font-weight:700;color:var(--ink-500);
  transition:all .18s ease;white-space:nowrap;
}
.chip.on{
  background:linear-gradient(150deg,var(--pink-400),var(--pink-600));
  color:var(--white);border-color:transparent;box-shadow:0 6px 16px rgba(240,86,141,.28);
}

/* Section header */
.sec-head{
  padding:6px 20px 10px;display:flex;align-items:baseline;justify-content:space-between;
  flex-shrink:0;
}
.sec-head b{
  font-size:15.5px;font-weight:800;color:var(--ink-900);display:flex;align-items:center;gap:9px;
}
.dot-trio{display:inline-flex;gap:4px;align-items:center}
.dot-trio i{display:block;border-radius:50%}
.dot-trio i:nth-child(1){width:7px;height:7px;background:var(--pink-500)}
.dot-trio i:nth-child(2){width:5px;height:5px;background:var(--pink-300)}
.dot-trio i:nth-child(3){width:4px;height:4px;background:var(--pink-200)}
.sec-head span{font-size:11.5px;font-weight:600;color:var(--ink-300)}

/* Scroll area */
.list{flex:1;overflow-y:auto;padding:0 20px 24px;-webkit-overflow-scrolling:touch}
.list::-webkit-scrollbar{width:0}

/* Edit banner */
.edit-banner{
  margin:4px 20px 10px;padding:10px 14px;border-radius:14px;
  background:linear-gradient(135deg,var(--pink-100),#FFF0E0);
  display:flex;align-items:center;justify-content:space-between;gap:10px;
  font-size:12.5px;font-weight:700;color:var(--pink-700);flex-shrink:0;
}
.edit-banner button{
  padding:6px 13px;border-radius:var(--radius-full);border:none;
  font-size:12px;font-weight:800;cursor:pointer;
}
.b-add{background:var(--white);color:var(--pink-600)}
.b-done{background:var(--pink-600);color:var(--white)}

/* Dish row — high-end list */
.dish{
  display:flex;align-items:center;gap:14px;padding:13px;background:var(--white);
  border-radius:var(--radius-l);margin-bottom:10px;position:relative;
  border:1.5px solid var(--pink-100);
  box-shadow:0 4px 14px rgba(232,68,124,.05);
  transition:transform .15s ease,box-shadow .15s ease;
}
.dish:active{transform:scale(.985);box-shadow:0 2px 8px rgba(232,68,124,.07)}
.thumb{
  width:74px;height:74px;border-radius:18px;flex-shrink:0;overflow:hidden;position:relative;
  display:flex;align-items:center;justify-content:center;font-size:30px;
  background:linear-gradient(135deg,var(--pink-100),#FFF4E5);
}
.thumb::after{
  content:"";position:absolute;inset:0;border-radius:18px;
  background-image:radial-gradient(rgba(255,255,255,.7) 2px,transparent 2.2px);
  background-size:14px 14px;background-position:8px 8px;opacity:.6;pointer-events:none;
}
.thumb .badge{
  position:absolute;top:6px;left:6px;z-index:2;
  font-size:9px;font-weight:800;letter-spacing:.04em;color:var(--white);
  background:var(--pink-600);padding:3px 7px;border-radius:var(--radius-full);
  box-shadow:0 3px 8px rgba(240,86,141,.35);
}
.info{flex:1;min-width:0}
.dname{
  font-size:15px;font-weight:800;color:var(--ink-900);
  line-height:1.35;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.ddesc{
  font-size:11.5px;font-weight:600;color:var(--ink-300);margin-top:5px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.price{
  font-size:17px;font-weight:900;color:var(--pink-600);letter-spacing:-.01em;
  flex-shrink:0;
}
.price em{font-style:normal;font-size:11px;margin-right:1px;font-weight:700}
.del-x{
  position:absolute;top:8px;right:8px;width:24px;height:24px;border-radius:50%;
  